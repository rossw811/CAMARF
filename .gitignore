__pycache__/
*.pyc

# Credentials — added 2026-09-01 during a public-repo hygiene sweep (repo has
# been public for weeks; none of these were ever actually committed, checked
# via git log --all and content grep, but there was no explicit protection
# against a future `git add -A` picking one up).
.pgpass
.env
.env.*
*.pem
*.key
id_rsa
id_rsa.*

# Large generated data/output — regenerate via the pipeline (see README.md
# "Reproducibility" / CLAUDE.md "Data Test Range & Reproducibility") rather
# than tracking multi-GB binary parquet in git history. latest_run_*.log
# summaries at repo root are small, curated, and intentionally still tracked
# (the pattern below matches the raw stdout/stderr dumps, NOT that file).
# output/* (not output/) so the lineage manifests -- small JSON change records, see lineage.py -- can be tracked.
output/*
!output/lineage/

# graphify-out/: the interactive chart + report ARE tracked (graph.html,
# graph_standalone.html, graph.json, GRAPH_REPORT.md, manifest.json) so the
# knowledge graph is browsable on GitHub without regenerating it locally.
# Only the regenerable AST/semantic cache and machine-local scratch state
# (e.g. .graphify_python, a literal local filesystem path) are ignored.
graphify-out/cache/
graphify-out/.graphify_*

# logs/archive/: ad-hoc raw run logs (underscore-prefixed, e.g.
# _data_ibkr_run.log) that predate the fixes below and got tracked by the
# same bug class — same rationale, untracked here.
logs/archive/*.log

# Run logs (2026-10-15 cleanup): every log stays local -- root latest_run_*.log summaries, logs/, *.pid. They are
# written by the code at every run (CLAUDE.md: read latest_run_*.log first) but are machine-local run records, not
# source. Logs cited as evidence before 2026-10-15 resolve at tag snapshot-2026-10-15-pre-cleanup; evidence logs that
# must travel with a claim go under docs/ (e.g. docs/bug_recheck/*.log), which is not ignored.
/*.log
/*.pid
/logs/
graphify-out/
